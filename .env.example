# Copy this file to .env for local development:
#   cp .env.example .env
#
# Defaults match docker-compose.yml. Change them together if you override them.
# Do not commit .env.

# Application
APP_NAME=Monteiro OS
APP_ENV=development

# PostgreSQL credentials shared by Compose and the backend.
POSTGRES_USER=monteiro
POSTGRES_PASSWORD=monteiro
POSTGRES_DB=monteiro

# Host and port used when the backend or Alembic run on the host machine.
# Docker Compose overrides POSTGRES_HOST to "db" inside the backend container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional full SQLAlchemy URL. When set, it replaces the POSTGRES_* pieces.
# Example:
# DATABASE_URL=postgresql+psycopg://monteiro:monteiro@localhost:5432/monteiro

# Published host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
