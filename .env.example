# Copy this file to .env for local development:
#   cp .env.example .env
#
# Defaults match docker-compose.yml. Change them together if you override them.
# Do not commit .env.

# Application
APP_NAME=Monteiro OS
APP_ENV=development

# Optional shared secret for the API. Leave empty for local development.
# Local Compose publishes ports on 127.0.0.1 only. Set this when the API can
# be reached beyond that loopback binding. It is not a user account.
# The Next.js server reads this name and sends X-Monteiro-Access. Do not put
# the value in a NEXT_PUBLIC_ variable. The secret does not protect the web
# app: an externally exposed frontend needs its own deployment protection.
APP_ACCESS_SECRET=

# Optional Esri World Imagery key for the production map. The Next.js server
# reads this name and attaches it to ArcGIS Location Platform requests. Do not
# put the value in a NEXT_PUBLIC_ variable. Leave it empty to use the Instituto
# Geográfico Nacional orthophoto and OpenStreetMap place search. Set it to use
# Esri World Imagery and Esri geocoding. The key needs Basemaps and Geocoding
# privileges. See the README for both providers.
ESRI_API_KEY=

# Base URL the Next.js server uses to reach FastAPI. Compose sets this to
# http://backend:8000 inside the frontend container. Host-side `npm run dev`
# uses the default http://127.0.0.1:8000 when this variable is empty.
BACKEND_URL=

# PostgreSQL credentials shared by Compose and the backend.
POSTGRES_USER=monteiro
POSTGRES_PASSWORD=monteiro
POSTGRES_DB=monteiro

# Host and port used when the backend or Alembic run on the host machine.
# Docker Compose overrides POSTGRES_HOST to "db" inside the backend container.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Optional full SQLAlchemy URL. When set, it replaces the POSTGRES_* pieces.
# Example:
# DATABASE_URL=postgresql+psycopg://monteiro:monteiro@localhost:5432/monteiro

# Published host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
